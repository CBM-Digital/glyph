(game comet-courier
  :title "Comet Courier"
  :size [480 360]
  :assets {:kit {:path "../assets/original/space.png"
                 :grid {:tile [64 64] :frames {:ship [0 0] :station [1 0] :cargo [2 0] :rock [3 0] :moon [4 0]}}}
           :main "../assets/fonts/NotoSans-Regular.ttf"
           :bold "../assets/fonts/NotoSans-SemiBold.ttf"
           :launch "../assets/audio/launch.wav" :dock "../assets/audio/dock.wav"
           :impact "../assets/audio/impact.wav" :brake "../assets/audio/brake.wav"
           :theme "../assets/audio/comet-theme.wav"}
  :initial initial :update update :view view)

; Sector one: six authored contracts. Physics and preview share physics-step.
(def contracts
  [{:name "First orbit" :sx 62 :sy 266 :tx 408 :ty 128 :gx 240 :gy 228 :force 250000 :radius 24 :rx 251 :ry 142 :cargo :standard :par 450}
   {:name "Over the moon" :sx 64 :sy 262 :tx 414 :ty 250 :gx 246 :gy 204 :force 300000 :radius 28 :rx 249 :ry 252 :cargo :standard :par 500}
   {:name "Handle with care" :sx 62 :sy 258 :tx 414 :ty 124 :gx 270 :gy 242 :force 230000 :radius 25 :rx 249 :ry 143 :cargo :fragile :par 650}
   {:name "The long way" :sx 60 :sy 248 :tx 415 :ty 114 :gx 256 :gy 174 :force 330000 :radius 25 :rx 251 :ry 104 :cargo :express :par 650}
   {:name "Blue hour" :sx 68 :sy 124 :tx 413 :ty 268 :gx 256 :gy 150 :force 240000 :radius 28 :rx 251 :ry 195 :cargo :standard :par 550}
   {:name "Soft landing" :sx 60 :sy 263 :tx 417 :ty 143 :gx 219 :gy 221 :force 260000 :radius 23 :rx 251 :ry 148 :cargo :fragile :par 700}])
(def initial {:phase :brief :t 0 :music false :start 0 :contract 0 :stage 0 :hull 3 :score 0 :rings 0
              :x 62 :y 266 :vx 0 :vy 0 :angle -22 :power 0.55 :brake true :flight 0 :ring false
              :preview [] :trail [] :drag false :flash 0 :message "" :saved false})
(defn level [s] (nth contracts (:contract s)))
(defn hit? [x y w h] (and (pointer-released?) (point-in-rect? (pointer-x) (pointer-y) (rect-box x y w h))))
(defn confirm? [] (or (pressed? :confirm) (pressed? :tap)))
(defn back? [] (or (pressed? :cancel) (hit? 12 12 62 32)))
(defn speed [s] (sqrt (+ (* (:vx s) (:vx s)) (* (:vy s) (:vy s)))))
(defn cargo-label [c] (case c :fragile "FRAGILE / dock below 190" :express "EXPRESS / speed bonus" else "STANDARD / bonus ring optional"))
(defn physics-step [s l]
  (let [dx (- (:gx l) (:x s)) dy (- (:gy l) (:y s))
        d (max 1 (sqrt (+ (* dx dx) (* dy dy))))
        force (/ (:force l) (+ (* d d) 900))
        vx (+ (:vx s) (* (/ dx d) force (/ 1 60)))
        vy (+ (:vy s) (* (/ dy d) force (/ 1 60)))]
    (assoc s :x (+ (:x s) (/ vx 60)) :y (+ (:y s) (/ vy 60)) :vx vx :vy vy)))
(defn launched [s]
  (let [v (+ 150 (* (:power s) 220)) a (deg->rad (:angle s))]
    (assoc s :vx (* (cos a) v) :vy (* (sin a) v))))
(defn preview-points [n p l result]
  (if (<= n 0) result
    (let [next (physics-step p l)]
      (if (or (< (:x next) 12) (> (:x next) 468) (< (:y next) 79) (> (:y next) 313)
              (< (dist (:x next) (:y next) (:gx l) (:gy l)) (+ (:radius l) 7)))
        result
        (preview-points (- n 1) next l (if (= (mod n 6) 0) (push result [(:x next) (:y next)]) result))))))
(defn prepare [s]
  (let [l (level s) angle (rad->deg (angle-to (:sx l) (:sy l) (:tx l) (:ty l)))
        next (assoc s :phase :aim :x (:sx l) :y (:sy l) :vx 0 :vy 0 :angle angle :power 0.55
                      :brake true :flight 0 :ring false :drag false :trail [] :flash 0 :message "Drag BACK from the ship, then release.")]
    (assoc next :preview (preview-points 90 (launched next) l []))))
(defn begin-run [s]
  (do (profile/set :comet-checkpoint nil) (random/seed (+ 1907 (:start s)))
      (prepare (assoc initial :music true :phase :aim :start (:start s) :contract (:start s)))))
(defn medal [s] (cond (and (= (:phase s) :win) (>= (:rings s) 3) (= (:hull s) 3)) 3 (= (:phase s) :win) 2 (> (:stage s) 0) 1 else 0))
(defn record [s]
  (if (:saved s) s
    (do (profile/set :comet-checkpoint nil) (arcade/complete {:game :comet :score (:score s) :medals (medal s)
                         :stats {:deliveries (:stage s) :rings (:rings s) :hull (:hull s)}})
        (assoc s :saved true))))
(defn damage [s message]
  (let [hull (- (:hull s) 1)]
    (do (sound/play :impact :volume 0.7)
        (if (<= hull 0) (record (assoc s :phase :over :hull 0 :message message :flash 1))
          (assoc s :phase :lost :hull hull :message message :flash 1)))))
(defn launch [s]
  (do (sound/play :launch :volume 0.7)
      (assoc (launched s) :phase :fly :drag false :message "One brake burst: tap / A / Space")))
(defn aim-step [dt s]
  (let [pressed (and (pointer-pressed?) (> (pointer-y) 82) (< (pointer-y) 316))
        dragging (or pressed (:drag s))
        dx (- (:x s) (pointer-x)) dy (- (:y s) (pointer-y))
        distance (sqrt (+ (* dx dx) (* dy dy)))
        angle (if (and dragging (> distance 8)) (rad->deg (angle-to 0 0 dx dy)) (+ (:angle s) (* (axis :move-x) dt 85)))
        power (if (and dragging (> distance 8)) (clamp (/ distance 115) 0.05 1) (clamp (- (:power s) (* (axis :move-y) dt 0.65)) 0.05 1))
        next (assoc s :angle angle :power power :drag dragging)
        changed (or (not= angle (:angle s)) (not= power (:power s)))
        next (if changed (assoc next :preview (preview-points 90 (launched next) (level next) [])) next)]
    (cond
      (and dragging (pointer-released?) (> distance 12)) (launch next)
      (and (pressed? :confirm) (not dragging)) (launch next)
      (pointer-released?) (assoc next :drag false)
      else next)))
(defn delivered [s]
  (let [points (+ 300 (if (:ring s) 250 0) (if (:brake s) 100 0)
                 (if (= (:cargo (level s)) :express) (max 0 (floor (* (- 5 (:flight s)) 80))) 0))
        stage (+ (:stage s) 1) next (assoc s :rings (+ (:rings s) (if (:ring s) 1 0)) :score (+ (:score s) points) :stage stage :flash 1 :message (str "Delivery +" points))]
    (do (sound/play :dock :volume 0.72)
        (if (= stage 3) (record (assoc next :phase :win)) (do (profile/set :comet-checkpoint {:version 1 :state (assoc next :contract (+ (:contract next) 1) :preview [] :trail [])})
                                                                         (assoc next :phase :delivered))))))
(defn fly-step [dt s]
  (let [braking (and (:brake s) (confirm?))
        base (if braking (do (sound/play :brake :volume 0.6) (assoc s :vx (* (:vx s) 0.46) :vy (* (:vy s) 0.46) :brake false)) s)
        moved (physics-step base (level s)) l (level s)
        new-ring (and (not (:ring s)) (< (dist (:x moved) (:y moved) (:rx l) (:ry l)) 22))
        trail (push (:trail s) [(:x s) (:y s)])
        trail (if (> (count trail) 20) (slice trail 1 (count trail)) trail)
        next (assoc moved :flight (+ (:flight s) dt) :trail trail :ring (or (:ring s) new-ring)
                         :rings (:rings s))]
    (if new-ring (sound/play :dock :volume 0.35 :pitch 1.3) nil)
    (cond
      (< (dist (:x next) (:y next) (:gx l) (:gy l)) (+ 7 (:radius l))) (damage next "Hit the moon. Bend the path around its edge.")
      (< (dist (:x next) (:y next) (:tx l) (:ty l)) 25)
        (if (and (= (:cargo l) :fragile) (> (speed next) 190)) (damage next "Docked too fast. Use your brake before arrival.") (delivered next))
      (or (< (:x next) 8) (> (:x next) 472) (< (:y next) 75) (> (:y next) 315)) (damage next "Left the sector. Use the dotted preview.")
      (> (:flight next) 9) (damage next "Delivery timed out. Try a stronger launch.")
      else next)))
(defn update [dt s]
  (let [s (if (:music s) s (do (music/play :theme :volume 0.28) (assoc s :music true)))
        s (assoc s :t (+ (:t s) dt) :flash (max 0 (- (:flash s) (* dt 3))))]
    (cond
      (back?) (do (navigation/pop) s)
      (= (:phase s) :brief)
        (cond
          (and (pressed? :secondary) (not= (profile/get :comet-checkpoint nil) nil))
            (let [checkpoint (profile/get :comet-checkpoint nil)]
              (if (= (:version checkpoint) 1) (prepare (assoc (:state checkpoint) :music true)) s))
          (or (pressed? :left) (pressed? :right) (hit? 118 237 244 32)) (assoc s :start (if (= (:start s) 0) 3 0))
          (or (confirm?) (hit? 118 282 244 42)) (begin-run s)
          else s)
      (= (:phase s) :aim) (aim-step dt s)
      (= (:phase s) :fly) (fly-step dt s)
      (or (confirm?) (hit? 90 262 300 60))
        (case (:phase s)
          :lost (prepare s)
          :delivered (prepare (assoc s :contract (+ (:contract s) 1)))
          else (begin-run s))
      else s)))
(defn label [value x y size color] (text :font :main :value value :x x :y y :size size :color color))
(defn bold [value x y size color] (text :font :bold :value value :x x :y y :size size :color color))
(defn button [value x y w]
  (group (rect :x x :y y :w w :h 36 :color "#f3ce7d") (bold value (+ x 14) (+ y 8) 14 "#152632")))
(defn background [s]
  (group
    (clear "#101c2d")
    (for [i (range 60)] (circle :x (+ 9 (mod (* i 83) 460)) :y (+ 76 (mod (* i 47) 238)) :r (if (= (mod i 7) 0) 1.5 0.7) :color (if (= (mod i 3) 0) "#6d879a" "#354960")))
    (rect :x 0 :y 0 :w 480 :h 68 :color "#16283a")
    (rect :x 0 :y 322 :w 480 :h 38 :color "#16283a")
    (label "< ARCADE" 16 23 11 "#9ebacb")
    (bold "COMET COURIER" 105 13 21 "#f5eee1")
    (label "01 / THE POSTAL FRONTIER" 107 43 10 "#91acbe")
    (label (str "BEST " (:score (profile/get :comet-record {:score 0}))) 355 26 11 "#f3ce7d")))
(defn brief [s]
  (group
    (sprite :image :kit :frame :ship :x 352 :y 82 :scale 1.4 :rotation -25)
    (label "A LITTLE SHIP. A BIG SHORTCUT." 36 90 11 "#f3ce7d")
    (bold "Bend gravity." 36 110 33 "#f5eee1")
    (bold "Deliver the impossible." 36 148 26 "#f5eee1")
    (label "Drag back from your ship. Release to launch." 36 193 14 "#b9ccd6")
    (label "Tap once in flight to brake. Chase the gold ring." 36 214 14 "#b9ccd6")
    (label (if (= (:start s) 0) "<  ROUTE A / LEARN THE ORBITS  >" "<  ROUTE B / PRECISION POST  >") 122 245 12 "#f3ce7d")
    (button "DEPART  /  A or Enter" 118 282 244)
    (label (if (not= (profile/get :comet-checkpoint nil) nil) "X: resume your saved route    /    A: new route" "Stick / arrows: aim & power     A: launch / brake") 62 334 11 "#9ebacb")))
(defn scene [s]
  (let [l (level s)]
    (group
      (circle :x (:gx l) :y (:gy l) :r (+ (:radius l) 25) :color "#172c40")
      (circle :x (:gx l) :y (:gy l) :r (+ (:radius l) 12) :color "#203c51")
      (circle :x (:gx l) :y (:gy l) :r (:radius l) :color "#557e8b")
      (sprite :image :kit :frame :moon :x (:gx l) :y (:gy l) :origin :center :scale (/ (:radius l) 25))
      (circle :x (:tx l) :y (:ty l) :r 27 :color "#31504f")
      (circle :x (:tx l) :y (:ty l) :r 23 :color "#101c2d")
      (sprite :image :kit :frame :station :x (:tx l) :y (:ty l) :origin :center :scale 0.68)
      (label "DOCK" (- (:tx l) 16) (+ (:ty l) 28) 10 "#a4d6c1")
      (if (not (:ring s)) (group
        (circle :x (:rx l) :y (:ry l) :r 20 :color "#f3ce7d")
        (circle :x (:rx l) :y (:ry l) :r 17 :color "#101c2d")
        (label "+250" (- (:rx l) 13) (+ (:ry l) 24) 9 "#f3ce7d")) empty)
      (for [p (:trail s)] (circle :x (nth p 0) :y (nth p 1) :r 2 :color "#597b8f"))
      (if (= (:phase s) :aim)
        (group
          (for [p (:preview s)] (circle :x (nth p 0) :y (nth p 1) :r 1.8 :color "#f3ce7d"))
          (line :from [(:x s) (:y s)] :angle (:angle s) :length (+ 20 (* (:power s) 25)) :width 2 :color "#f3ce7d")) empty)
      (sprite :image :kit :frame :ship :x (:x s) :y (:y s) :origin :center :scale 0.58 :rotation (+ 90 (if (= (:phase s) :aim) (:angle s) (rad->deg (angle-to 0 0 (:vx s) (:vy s))))))
      (label (str (:name l) "  /  " (min 3 (+ (:stage s) 1)) " of 3") 16 77 12 "#f5eee1")
      (label (str "HULL " (:hull s) "     " (:score s) " pts") 318 77 11 "#f3ce7d")
      (label (cargo-label (:cargo l)) 16 301 10 "#a4d6c1")
      (label (if (= (:phase s) :aim) "DRAG BACK / release to sling" (str "SPEED " (floor (speed s)) "    " (if (:brake s) "BRAKE READY" "BRAKE USED"))) 16 334 11 "#b9ccd6")
      (rect :x 343 :y 336 :w 113 :h 7 :color "#314457")
      (rect :x 343 :y 336 :w (* 113 (:power s)) :h 7 :color "#f3ce7d"))))
(defn result-panel [s]
  (group
    (rect :x 32 :y 119 :w 416 :h 187 :color "#152c3c")
    (rect :x 32 :y 119 :w 4 :h 187 :color "#f3ce7d")
    (bold (case (:phase s) :win "Route delivered!" :over "End of the route" :lost "Cargo lost" else "Special delivery!") 55 134 27 "#f5eee1")
    (label (:message s) 55 177 12 "#b9ccd6")
    (label (str (:score s) " POINTS   /   " (:rings s) " RINGS   /   HULL " (:hull s)) 55 205 13 "#f3ce7d")
    (label (if (or (= (:phase s) :win) (= (:phase s) :over))
              (case (medal s) 3 "GOLD MEDAL / three rings, perfect hull." 2 "SILVER MEDAL / route complete." 1 "BRONZE MEDAL / your first delivery." else "A new line could change everything.")
              "A new line could change everything.") 55 232 12 "#a4d6c1")
    (button (case (:phase s) :delivered "NEXT DELIVERY  /  A" :lost "TRY AGAIN  /  A" else "ANOTHER RUN  /  A") 90 264 300)))
(defn view [s]
  (group (background s)
    (if (= (:phase s) :brief) (brief s)
      (group (scene s) (if (or (= (:phase s) :aim) (= (:phase s) :fly)) empty (result-panel s))))))
