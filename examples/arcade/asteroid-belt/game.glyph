(game asteroid-belt
  :title "Asteroid Belt"
  :size [480 360]
  :assets {:kit "../assets/kenney/strips/space-kit.png"
           :sheet {:path "../assets/kenney/sheets/space-sheet.png"
                   :grid {:tile [48 48]
                          :frames {:planet [0 0]
                                   :moon [1 0]
                                   :station [2 0]}}}
           :main "/System/Library/Fonts/Supplemental/Arial.ttf"
           :blip "../assets/blip.wav"
           :pop "../assets/pop.wav"
           :theme "../assets/theme.wav"}
  :initial initial
  :update update
  :view view)

(defn ufo-off [] {:active false :x 0 :y 0 :vx 0})
(defn power-off [] {:active false :x 0 :y 0 :kind :shield :timer 0})

(def initial
  {:t 0 :phase :title :timer 0 :music false
   :x 240 :y 190 :vx 0 :vy 0 :angle 0
   :cool 0 :invul 0 :warp 0 :shield 0
   :lives 3 :score 0 :hi 0 :wave 0
   :combo 1 :combo-time 0 :flash 0 :shake 0
   :next-id 20 :ufo-clock 5.5
   :bullets [] :asteroids [] :sparks []
   :ufo (ufo-off) :power (power-off)})

(defn frame [n]
  (case (mod n 8)
    0 :f0
    1 :f1
    2 :f2
    3 :f3
    4 :f4
    5 :f5
    6 :f6
    else :f7))

(defn back? []
  (and (pointer-released?)
       (point-in-rect? (pointer-x) (pointer-y) (rect-box 12 12 70 30))))

(defn action? []
  (or (pressed? :tap) (pointer-pressed?) (pressed? :up)))

(defn wrap-x [x]
  (cond
    (< x -28) 508
    (> x 508) -28
    else x))

(defn wrap-y [y]
  (cond
    (< y -28) 388
    (> y 388) -28
    else y))

(defn ship-dx [angle]
  (sin (deg->rad angle)))

(defn ship-dy [angle]
  (- 0 (cos (deg->rad angle))))

(defn rock-radius [size]
  (case size
    3 31
    2 23
    else 15))

(defn rock-scale [size]
  (case size
    3 1.22
    2 0.88
    else 0.58))

(defn rock-score [size]
  (case size
    3 25
    2 50
    else 100))

(defn fresh-play [state]
  (assoc initial
    :phase :playing
    :music (:music state)
    :hi (max (:hi state) (:score state))
    :wave 1
    :ufo-clock 5.5
    :timer 0))

(defn spawn-x [slot]
  (case (mod slot 4)
    0 -24
    1 504
    2 (rand-range 36 444)
    else (rand-range 36 444)))

(defn spawn-y [slot]
  (case (mod slot 4)
    0 (rand-range 64 326)
    1 (rand-range 64 326)
    2 -24
    else 384))

(defn spawn-vx [slot wave]
  (let [speed (+ 32 (* wave 7))]
    (case (mod slot 4)
      0 (rand-range speed (+ speed 36))
      1 (- 0 (rand-range speed (+ speed 36)))
      2 (rand-range -48 48)
      else (rand-range -48 48))))

(defn spawn-vy [slot wave]
  (let [speed (+ 28 (* wave 5))]
    (case (mod slot 4)
      0 (rand-range -46 46)
      1 (rand-range -46 46)
      2 (rand-range speed (+ speed 34))
      else (- 0 (rand-range speed (+ speed 34))))))

(defn add-rock [state slot size]
  (let [id (:next-id state)
        wave (:wave state)]
    (assoc state
      :next-id (+ id 1)
      :asteroids
        (push (:asteroids state)
          {:id id
           :x (spawn-x slot)
           :y (spawn-y slot)
           :vx (spawn-vx slot wave)
           :vy (spawn-vy slot wave)
           :size size
           :rot (rand-range 0 360)
           :spin (rand-range -70 70)}))))

(defn wave-count [wave]
  (min 8 (+ wave 3)))

(defn add-wave-slot [state slot]
  (if (< slot (wave-count (:wave state)))
    (add-rock state slot 3)
    state))

(defn spawn-wave [state]
  (add-wave-slot
    (add-wave-slot
      (add-wave-slot
        (add-wave-slot
          (add-wave-slot
            (add-wave-slot
              (add-wave-slot
                (add-wave-slot state 0)
                1)
              2)
            3)
          4)
        5)
      6)
    7))

(defn start-game [state]
  (do
    (sound/play :blip :volume 0.75)
    (spawn-wave (fresh-play state))))

(defn arm-music [state]
  (if (:music state)
    state
    (do
      (music/play :theme :volume 0.08)
      (assoc state :music true))))

(defn update-ship [dt state]
  (let [turn (axis :move-x)
        thrust (or (held? :up) (< (axis :move-y) -0.4))
        angle (+ (:angle state) (* turn dt 235))
        ax (if thrust (* (ship-dx angle) 255) 0)
        ay (if thrust (* (ship-dy angle) 255) 0)
        damp (- 1 (* dt (if thrust 0.18 0.42)))
        vx (clamp (* (+ (:vx state) (* ax dt)) damp) -235 235)
        vy (clamp (* (+ (:vy state) (* ay dt)) damp) -235 235)]
    (assoc state
      :angle angle
      :vx vx
      :vy vy
      :x (wrap-x (+ (:x state) (* vx dt)))
      :y (wrap-y (+ (:y state) (* vy dt))))))

(defn bullet-life? [bullet]
  (> (:life bullet) 0))

(defn update-bullet [dt bullet]
  (assoc bullet
    :x (wrap-x (+ (:x bullet) (* (:vx bullet) dt)))
    :y (wrap-y (+ (:y bullet) (* (:vy bullet) dt)))
    :life (- (:life bullet) dt)))

(defn update-bullets [dt state]
  (assoc state :bullets
    (filter
      (map (:bullets state) (fn [bullet] (update-bullet dt bullet)))
      (fn [bullet] (bullet-life? bullet)))))

(defn fire-bullet [state]
  (if (and (action?) (<= (:cool state) 0))
    (let [id (:next-id state)
          dx (ship-dx (:angle state))
          dy (ship-dy (:angle state))]
      (do
        (sound/play :blip :volume 0.45 :pitch 1.25)
        (assoc state
          :next-id (+ id 1)
          :cool 0.18
          :bullets
            (push (:bullets state)
              {:id id
               :x (+ (:x state) (* dx 24))
               :y (+ (:y state) (* dy 24))
               :vx (+ (:vx state) (* dx 330))
               :vy (+ (:vy state) (* dy 330))
               :life 0.92}))))
    state))

(defn update-rock [dt rock]
  (assoc rock
    :x (wrap-x (+ (:x rock) (* (:vx rock) dt)))
    :y (wrap-y (+ (:y rock) (* (:vy rock) dt)))
    :rot (+ (:rot rock) (* (:spin rock) dt))))

(defn update-rocks [dt state]
  (assoc state :asteroids
    (map (:asteroids state) (fn [rock] (update-rock dt rock)))))

(defn spark [x y color n]
  {:x x :y y
   :vx (* (cos (* n 1.27)) (rand-range 30 120))
   :vy (* (sin (* n 1.27)) (rand-range 30 120))
   :life (rand-range 0.28 0.58)
   :color color})

(defn add-sparks [state x y color]
  (assoc state :sparks
    (push (:sparks state)
      (spark x y color 0)
      (spark x y color 1)
      (spark x y color 2)
      (spark x y color 3)
      (spark x y color 4)
      (spark x y color 5))))

(defn update-spark [dt item]
  (assoc item
    :x (+ (:x item) (* (:vx item) dt))
    :y (+ (:y item) (* (:vy item) dt))
    :life (- (:life item) dt)))

(defn update-sparks [dt state]
  (assoc state :sparks
    (filter
      (map (:sparks state) (fn [item] (update-spark dt item)))
      (fn [item] (> (:life item) 0)))))

(defn bullet-rock? [bullet rock]
  (< (dist (:x bullet) (:y bullet) (:x rock) (:y rock))
     (+ (rock-radius (:size rock)) 4)))

(defn hit-bullet [state rock]
  (find (:bullets state) (fn [bullet] (bullet-rock? bullet rock))))

(defn hit-rock [state]
  (find (:asteroids state) (fn [rock] (hit-bullet state rock))))

(defn remove-bullet [state bullet]
  (assoc state :bullets
    (remove (:bullets state) (fn [b] (= (:id b) (:id bullet))))))

(defn remove-rock [state rock]
  (assoc state :asteroids
    (remove (:asteroids state) (fn [r] (= (:id r) (:id rock))))))

(defn split-child [state rock dir]
  (let [id (:next-id state)
        size (- (:size rock) 1)
        speed (+ 56 (* (:wave state) 8))
        theta (deg->rad (+ (:rot rock) (* dir 57)))]
    (assoc state
      :next-id (+ id 1)
      :asteroids
        (push (:asteroids state)
          {:id id
           :x (:x rock)
           :y (:y rock)
           :vx (+ (:vx rock) (* (cos theta) speed))
           :vy (+ (:vy rock) (* (sin theta) speed))
           :size size
           :rot (rand-range 0 360)
           :spin (rand-range -120 120)}))))

(defn split-rock [state rock]
  (if (> (:size rock) 1)
    (split-child (split-child state rock 0.9) rock 3.8)
    state))

(defn spawn-power [state rock]
  (if (and (not (:active (:power state))) (chance 0.18))
    (assoc state :power
      {:active true
       :x (:x rock)
       :y (:y rock)
       :kind (if (chance 0.62) :shield :repair)
       :timer 7.5})
    state))

(defn resolve-rock-hit [state]
  (let [rock (hit-rock state)]
    (if rock
      (let [bullet (hit-bullet state rock)
            gained (* (:combo state) (rock-score (:size rock)))
            cleared (remove-rock (remove-bullet state bullet) rock)
            scored (assoc cleared
                      :score (+ (:score cleared) gained)
                      :combo (min 5 (+ (:combo state) 1))
                      :combo-time 1.4
                      :flash 0.35
                      :shake 0.08)]
        (do
          (sound/play :pop :volume 0.58 :pitch (if (= (:size rock) 1) 1.28 0.92))
          (spawn-power
            (split-rock
              (add-sparks scored (:x rock) (:y rock) "#fbbf24")
              rock)
            rock)))
      state)))

(defn collect-power? [state]
  (and (:active (:power state))
       (< (dist (:x state) (:y state) (:x (:power state)) (:y (:power state))) 28)))

(defn update-power [dt state]
  (let [power (:power state)]
    (cond
      (collect-power? state)
        (do
          (sound/play :blip :volume 0.85 :pitch 0.82)
          (assoc state
            :power (power-off)
            :shield (if (= (:kind power) :shield) (min 3 (+ (:shield state) 1)) (:shield state))
            :lives (if (= (:kind power) :repair) (min 5 (+ (:lives state) 1)) (:lives state))
            :flash 0.42))
      (:active power)
        (let [timer (- (:timer power) dt)]
          (if (> timer 0)
            (assoc-in state [:power :timer] timer)
            (assoc state :power (power-off))))
      else state)))

(defn spawn-ufo [state]
  (let [left (chance 0.5)
        y (rand-range 82 278)]
    (assoc state
      :ufo {:active true
            :x (if left -42 522)
            :y y
            :vx (if left (+ 72 (* (:wave state) 4)) (- 0 (+ 72 (* (:wave state) 4))))}
      :ufo-clock (rand-range 7 12))))

(defn update-ufo [dt state]
  (let [ufo (:ufo state)]
    (cond
      (:active ufo)
        (let [x (+ (:x ufo) (* (:vx ufo) dt))
              y (+ (:y ufo) (* (sin (* (:t state) 2.4)) dt 28))]
          (if (or (< x -58) (> x 538))
            (assoc state :ufo (ufo-off))
            (assoc state :ufo (assoc ufo :x x :y y))))
      (and (= (:phase state) :playing) (> (:wave state) 1))
        (let [clock (- (:ufo-clock state) dt)]
          (if (<= clock 0)
            (spawn-ufo state)
            (assoc state :ufo-clock clock)))
      else state)))

(defn ufo-hit-bullet [state]
  (if (:active (:ufo state))
    (find (:bullets state)
      (fn [bullet] (< (dist (:x bullet) (:y bullet) (:x (:ufo state)) (:y (:ufo state))) 22)))
    nil))

(defn resolve-ufo-hit [state]
  (let [bullet (ufo-hit-bullet state)]
    (if bullet
      (do
        (sound/play :blip :volume 0.92 :pitch 0.7)
        (add-sparks
          (assoc
            (remove-bullet state bullet)
            :ufo (ufo-off)
            :score (+ (:score state) 250)
            :combo (min 5 (+ (:combo state) 1))
            :combo-time 1.4
            :flash 0.5
            :shake 0.16)
          (:x (:ufo state))
          (:y (:ufo state))
          "#93c5fd"))
      state)))

(defn ship-rock [state]
  (find (:asteroids state)
    (fn [rock] (< (dist (:x state) (:y state) (:x rock) (:y rock))
                  (+ 13 (rock-radius (:size rock)))))))

(defn crash [state rock]
  (let [lives (- (:lives state) 1)
        hi (max (:hi state) (:score state))]
    (do
      (sound/play :pop :volume 0.95 :pitch 0.68)
      (add-sparks
        (assoc state
          :lives lives
          :hi hi
          :phase (if (<= lives 0) :over :playing)
          :x 240 :y 190 :vx 0 :vy 0 :angle 0
          :invul (if (<= lives 0) 0 2.0)
          :shield 0
          :combo 1 :combo-time 0
          :flash 0.75 :shake 0.45)
        (:x rock)
        (:y rock)
        "#fb7185"))))

(defn shield-bash [state rock]
  (do
    (sound/play :blip :volume 0.72 :pitch 0.62)
    (add-sparks
      (split-rock
        (remove-rock
          (assoc state
            :shield (- (:shield state) 1)
            :score (+ (:score state) 40)
            :invul 0.45
            :flash 0.45
            :shake 0.14)
          rock)
        rock)
      (:x rock)
      (:y rock)
      "#67e8f9")))

(defn resolve-ship-hit [state]
  (if (> (:invul state) 0)
    state
    (let [rock (ship-rock state)]
      (if rock
        (if (> (:shield state) 0)
          (shield-bash state rock)
          (crash state rock))
        state))))

(defn ufo-touch? [state]
  (and (:active (:ufo state))
       (<= (:invul state) 0)
       (< (dist (:x state) (:y state) (:x (:ufo state)) (:y (:ufo state))) 26)))

(defn resolve-ufo-touch [state]
  (if (ufo-touch? state)
    (if (> (:shield state) 0)
      (do
        (sound/play :blip :volume 0.7 :pitch 0.7)
        (add-sparks
          (assoc state
            :ufo (ufo-off)
            :shield (- (:shield state) 1)
            :score (+ (:score state) 180)
            :invul 0.45
            :flash 0.45
            :shake 0.16)
          (:x (:ufo state))
          (:y (:ufo state))
          "#93c5fd"))
      (crash state {:x (:x (:ufo state)) :y (:y (:ufo state))}))
    state))

(defn hyperspace [state]
  (if (and (pressed? :down) (<= (:warp state) 0))
    (do
      (sound/play :blip :volume 0.5 :pitch 0.55)
      (assoc state
        :x (rand-range 74 406)
        :y (rand-range 92 312)
        :vx 0 :vy 0
        :warp 3.5
        :invul (max (:invul state) 0.9)
        :flash 0.28))
    state))

(defn check-wave-clear [state]
  (if (and (= (:phase state) :playing) (empty? (:asteroids state)))
    (do
      (sound/play :blip :volume 0.8 :pitch 0.92)
      (assoc state :phase :between :timer 1.65 :wave (+ (:wave state) 1) :combo 1))
    state))

(defn timed [dt state]
  (assoc state
    :t (+ (:t state) dt)
    :cool (max 0 (- (:cool state) dt))
    :invul (max 0 (- (:invul state) dt))
    :warp (max 0 (- (:warp state) dt))
    :flash (max 0 (- (:flash state) (* dt 2.5)))
    :shake (max 0 (- (:shake state) (* dt 3.0)))
    :combo-time (max 0 (- (:combo-time state) dt))
    :combo (if (> (:combo-time state) 0) (:combo state) 1)))

(defn play-step [dt state]
  (check-wave-clear
    (resolve-ufo-touch
      (resolve-ship-hit
        (update-power dt
          (resolve-rock-hit
            (resolve-ufo-hit
              (update-ufo dt
                (update-rocks dt
                  (fire-bullet
                    (hyperspace
                      (update-ship dt
                        (update-bullets dt
                          (update-sparks dt
                            (timed dt state)))))))))))))))

(defn update [dt state]
  (cond
    (back?) (do (sound/play :pop :volume 0.55) (navigation/pop) state)
    (= (:phase state) :title)
      (let [base (arm-music (timed dt state))]
        (if (action?) (start-game base) base))
    (= (:phase state) :over)
      (let [base (arm-music (timed dt state))]
        (if (action?) (start-game base) base))
    (= (:phase state) :between)
      (let [next (arm-music (timed dt (update-power dt state)))]
        (if (<= (:timer next) 0)
          (spawn-wave (assoc next :phase :playing))
          (assoc next :timer (- (:timer next) dt))))
    else (play-step dt (arm-music state))))

(defn back-button []
  (group
    (rect :x 12 :y 12 :w 70 :h 30 :color "#1f2937")
    (text :font :main :value "Back" :x 27 :y 20 :size 12 :color "#e5f6ff")))

(defn star-x [i state]
  (mod (+ (* i 47) (* (:t state) (+ 7 (mod i 5)))) 480))

(defn star-y [i state]
  (mod (+ (* i 83) (* (:t state) (+ 13 (mod i 7)))) 360))

(defn star [i state]
  (let [near (= (mod i 4) 0)]
    (circle :x (star-x i state) :y (star-y i state) :r (if near 1.7 1) :color (if near "#dbeafe" "#64748b"))))

(defn draw-rock [rock]
  (let [r (rock-radius (:size rock))
        s (rock-scale (:size rock))]
    (transform :x (:x rock) :y (:y rock) :rotation (:rot rock)
      (group
        (circle :x 0 :y 0 :r (+ r 3) :color "#2f2430")
        (sprite :image :kit :frame (frame 3) :x (- 0 (* 24 s)) :y (- 0 (* 24 s)) :scale s)))))

(defn draw-bullet [bullet]
  (group
    (circle :x (:x bullet) :y (:y bullet) :r 4 :color "#e0f2fe")
    (circle :x (:x bullet) :y (:y bullet) :r 2 :color "#fef3c7")))

(defn draw-spark [item]
  (circle :x (:x item) :y (:y item) :r (max 1 (* (:life item) 6)) :color (:color item)))

(defn draw-ship [state]
  (let [thrust (or (held? :up) (< (axis :move-y) -0.4))
        flicker (> (sin (* (:t state) 24)) 0)]
    (group
      (if (or (> (:shield state) 0) (> (:invul state) 0))
        (circle :x (:x state) :y (:y state) :r (if (> (:shield state) 0) 29 24)
                :color (if (> (:shield state) 0) "#155e75" "#4b5563"))
        empty)
      (transform :x (:x state) :y (:y state) :rotation (:angle state)
        (group
          (if (and thrust flicker)
            (group
              (line :x1 0 :y1 18 :x2 0 :y2 36 :width 7 :color "#f97316")
              (line :x1 0 :y1 18 :x2 0 :y2 29 :width 3 :color "#fde68a"))
            empty)
          (sprite :image :kit :frame (frame 0) :x -24 :y -24 :scale 1))))))

(defn draw-ufo [state]
  (if (:active (:ufo state))
    (let [ufo (:ufo state)]
      (group
        (circle :x (:x ufo) :y (:y ufo) :r 24 :color "#1e293b")
        (sprite :image :kit :frame (frame 6) :x (- (:x ufo) 24) :y (- (:y ufo) 24) :scale 1)
        (line :x1 (- (:x ufo) 22) :y1 (+ (:y ufo) 20) :x2 (+ (:x ufo) 22) :y2 (+ (:y ufo) 20) :width 2 :color "#93c5fd")))
    empty))

(defn draw-power [state]
  (let [power (:power state)]
    (if (:active power)
      (group
        (circle :x (:x power) :y (:y power) :r (+ 16 (* 3 (sin (* (:t state) 8)))) :color (if (= (:kind power) :shield) "#155e75" "#14532d"))
        (sprite :image :kit :frame (if (= (:kind power) :shield) (frame 7) (frame 2))
                :x (- (:x power) 18) :y (- (:y power) 18) :scale 0.75))
      empty)))

(defn hud-heart [i state]
  (circle :x (+ 266 (* i 16)) :y 27 :r 6 :color (if (< i (:lives state)) "#fb7185" "#334155")))

(defn hud-shield [i state]
  (circle :x (+ 266 (* i 16)) :y 45 :r 5 :color (if (< i (:shield state)) "#67e8f9" "#334155")))

(defn combo-text [state]
  (if (> (:combo state) 1)
    (text :font :main :value (str "x" (:combo state) " combo") :x 362 :y 50 :size 11 :color "#fde68a")
    empty))

(defn hud [state]
  (group
    (rect :x 0 :y 0 :w 480 :h 64 :color "#08111f")
    (back-button)
    (text :font :main :value "Asteroid Belt" :x 96 :y 13 :size 18 :color "#e5f6ff")
    (text :font :main :value (str "Score " (:score state)) :x 96 :y 39 :size 12 :color "#93c5fd")
    (text :font :main :value (str "Wave " (:wave state)) :x 184 :y 39 :size 12 :color "#fde68a")
    (for [i (range 5)] (hud-heart i state))
    (for [i (range 3)] (hud-shield i state))
    (text :font :main :value (str "Best " (:hi state)) :x 362 :y 24 :size 12 :color "#cbd5e1")
    (combo-text state)))

(defn controls-text []
  (group
    (text :font :main :value "Arrows/WASD steer" :x 38 :y 330 :size 11 :color "#94a3b8")
    (text :font :main :value "Space fires  Down warps" :x 298 :y 330 :size 11 :color "#94a3b8")))

(defn title-panel [state]
  (group
    (rect :x 54 :y 90 :w 372 :h 166 :color "#0f172a")
    (sprite :image :sheet :src :planet :x 324 :y 116 :scale 0.72)
    (sprite :image :sheet :src :moon :x 374 :y 168 :scale 0.54)
    (sprite :image :sheet :src :station :x 334 :y 204 :scale 0.5)
    (text :font :main :value "Asteroid Belt" :x 92 :y 110 :size 33 :color "#e5f6ff")
    (text :font :main :value "Split rocks chain combos grab shields" :x 92 :y 154 :size 14 :color "#93c5fd")
    (text :font :main :value "Shoot saucers for bonus points" :x 92 :y 178 :size 14 :color "#fde68a")
    (text :font :main :value "Tap or Space to launch" :x 126 :y 220 :size 16 :color (if (> (sin (* (:t state) 5)) 0) "#f8fafc" "#94a3b8"))))

(defn between-panel [state]
  (group
    (rect :x 130 :y 132 :w 220 :h 84 :color "#0f172a")
    (text :font :main :value (str "Wave " (:wave state)) :x 184 :y 150 :size 28 :color "#e5f6ff")
    (text :font :main :value "Incoming belt density rising" :x 154 :y 190 :size 12 :color "#93c5fd")))

(defn over-panel [state]
  (group
    (rect :x 82 :y 104 :w 316 :h 136 :color "#0f172a")
    (text :font :main :value "Ship Lost" :x 162 :y 122 :size 31 :color "#fecaca")
    (text :font :main :value (str "Score " (:score state)) :x 166 :y 166 :size 17 :color "#fde68a")
    (text :font :main :value (str "Best " (:hi state)) :x 178 :y 190 :size 15 :color "#93c5fd")
    (text :font :main :value "Tap or Space to retry" :x 146 :y 216 :size 13 :color "#e5f6ff")))

(defn camera-shake [state]
  (* (:shake state) (sin (* (:t state) 60)) 10))

(defn view [state]
  (let [sx (camera-shake state)
        flash (:flash state)]
    (group
      (clear "#050814")
      (for [i (range 58)] (star i state))
      (camera :x sx :y (- 0 sx)
        (group
          (for [rock (:asteroids state)] (draw-rock rock))
          (for [bullet (:bullets state)] (draw-bullet bullet))
          (for [item (:sparks state)] (draw-spark item))
          (draw-power state)
          (draw-ufo state)
          (if (not= (:phase state) :title) (draw-ship state) empty)))
      (if (> flash 0)
        (group
          (rect :x 0 :y 64 :w 480 :h 4 :color (if (> (:shield state) 0) "#67e8f9" "#fb7185"))
          (rect :x 0 :y 356 :w 480 :h 4 :color (if (> (:shield state) 0) "#67e8f9" "#fb7185"))
          (rect :x 0 :y 64 :w 4 :h 296 :color (if (> (:shield state) 0) "#67e8f9" "#fb7185"))
          (rect :x 476 :y 64 :w 4 :h 296 :color (if (> (:shield state) 0) "#67e8f9" "#fb7185")))
        empty)
      (hud state)
      (controls-text)
      (cond
        (= (:phase state) :title) (title-panel state)
        (= (:phase state) :between) (between-panel state)
        (= (:phase state) :over) (over-panel state)
        else empty))))
