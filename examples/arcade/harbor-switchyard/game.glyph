(game harbor-switchyard
  :title "Harbor Switchyard"
  :size [480 360]
  :assets {:pirate "../assets/kenney/strips/pirate-kit.png"
           :town "../assets/kenney/strips/tiny-town-kit.png"
           :items "../assets/kenney/sheets/items-colored.png"
           :main "/System/Library/Fonts/Supplemental/Arial.ttf"
           :blip "../assets/blip.wav"
           :pop "../assets/pop.wav"}
  :initial initial
  :update update
  :view view)

(def initial {:t 0 :phase :play :score 0 :near 0 :switch 1 :cargo 0
              :x 34 :x2 -146 :route2 0 :strikes 0 :flash 0
              :message "Tap switches to route boats to matching docks"})

(defn frame [n]
  (case (mod n 8)
    0 :f0
    1 :f1
    2 :f2
    3 :f3
    4 :f4
    5 :f5
    6 :f6
    else :f7))

(defn route-y [r]
  (case (mod r 3)
    0 118
    1 190
    else 262))

(defn route-color [r]
  (case (mod r 3)
    0 "#facc15"
    1 "#38bdf8"
    else "#fb7185"))

(defn back? []
  (and (pointer-released?)
       (point-in-rect? (pointer-x) (pointer-y) (rect-box 12 12 72 30))))

(defn restart? []
  (or (pressed? :tap) (and (pointer-released?) (> (pointer-y) 80))))

(defn switch-hit? []
  (and (pointer-released?)
       (point-in-circle? (pointer-x) (pointer-y) (circle-box 244 190 42))))

(defn boat-box [x y] (rect-box (- x 23) (- y 15) 46 30))

(defn next-boat [state message]
  (assoc state :x 34 :cargo (rand-int 3) :message message :flash 1))

(defn dock-check [state]
  (if (> (:x state) 430)
    (if (= (:switch state) (:cargo state))
      (do
        (sound/play :blip :volume 0.84 :pitch 1.18)
        (next-boat (assoc state :score (+ (:score state) 20 (:near state)) :near 0) "Boat docked"))
      (let [strikes (+ (:strikes state) 1)]
        (do
          (sound/play :pop :volume 0.7)
          (if (>= strikes 3)
            (assoc state :phase :over :strikes strikes :message "Harbor jammed")
            (next-boat (assoc state :strikes strikes :near 0) "Wrong dock")))))
    state))

(defn collision? [state]
  (and (> (:x2 state) 20)
       (< (abs (- (:x state) (:x2 state))) 42)
       (= (:switch state) (:route2 state))))

(defn update [dt state]
  (cond
    (back?) (do (sound/play :pop :volume 0.55) (navigation/pop) state)
    (and (= (:phase state) :over) (restart?)) initial
    (= (:phase state) :over) (assoc state :t (+ (:t state) dt))
    else
      (let [switched (if (switch-hit?)
                       (do (sound/play :blip :volume 0.55) (assoc state :switch (mod (+ (:switch state) 1) 3) :near (+ (:near state) 3)))
                       state)
            x (+ (:x switched) (* dt (+ 86 (* (:score switched) 0.4))))
            x2 (+ (:x2 switched) (* dt 72))
            reset2 (if (> x2 520) -120 x2)
            route2 (if (> x2 520) (rand-int 3) (:route2 switched))
            moved (assoc switched :t (+ (:t switched) dt) :x x :x2 reset2 :route2 route2 :flash (max 0 (- (:flash switched) (* dt 2))))]
        (if (collision? moved)
          (do (sound/play :pop :volume 0.82) (assoc moved :phase :over :message "Boats collided" :flash 1))
          (dock-check moved)))))

(defn back-button []
  (group
    (rect :x 12 :y 12 :w 72 :h 30 :color "#17343e")
    (text :font :main :value "Back" :x 29 :y 18 :size 13 :color "#ecfeff")))

(defn dock [r]
  (group
    (rect :x 422 :y (- (route-y r) 24) :w 46 :h 48 :color "#0f172a")
    (rect :x 428 :y (- (route-y r) 18) :w 34 :h 36 :color (route-color r))))

(defn boat [x y cargo flip]
  (group
    (rect :x (- x 23) :y (- y 11) :w 46 :h 22 :color (route-color cargo))
    (sprite :image :pirate :frame (frame 4) :x (- x 24) :y (- y 24) :scale 0.85 :flip-x flip)))

(defn over-panel [state]
  (if (= (:phase state) :over)
    (group
      (rect :x 98 :y 122 :w 284 :h 112 :color "#102a34")
      (text :font :main :value "Harbor Jammed" :x 154 :y 144 :size 24 :color "#ecfeff")
      (text :font :main :value (str "Score " (:score state)) :x 190 :y 176 :size 17 :color "#fde68a")
      (text :font :main :value "Tap to restart" :x 180 :y 204 :size 15 :color "#a5f3fc"))
    empty))

(defn view [state]
  (group
    (clear "#083344")
    (rect :x 0 :y 0 :w 480 :h 62 :color "#17343e")
    (back-button)
    (text :font :main :value "Harbor Switchyard" :x 102 :y 17 :size 22 :color "#ecfeff")
    (text :font :main :value (str "Score " (:score state) "  Strikes " (:strikes state) "/3") :x 318 :y 21 :size 12 :color "#fde68a")
    (text :font :main :value (:message state) :x 108 :y 44 :size 11 :color "#a5f3fc")
    (for [r (range 3)] (line :from [34 (route-y r)] :angle 0 :length 390 :width 6 :color "#155e75"))
    (for [r (range 3)] (dock r))
    (circle :x 244 :y 190 :r 38 :color "#0f172a")
    (circle :x 244 :y 190 :r 24 :color (route-color (:switch state)))
    (text :font :main :value "SW" :x 234 :y 182 :size 12 :color "#ecfeff")
    (boat (:x state) (route-y (:switch state)) (:cargo state) false)
    (boat (:x2 state) (route-y (:route2 state)) (:route2 state) true)
    (over-panel state)))
