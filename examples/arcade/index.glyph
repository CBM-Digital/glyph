(game arcade-index
  :title "Glyph Arcade"
  :size [480 360]
  :assets {:logo "assets/glyph-logo.png"
           :orb "assets/kenney/strips/puzzle-kit.png"
           :sports "assets/kenney/strips/sports-kit.png"
           :board "assets/kenney/strips/boardgame-kit.png"
           :tank "assets/kenney/strips/tank-kit.png"
           :town "assets/kenney/strips/tiny-town-kit.png"
           :battle "assets/kenney/strips/tiny-battle-kit.png"
           :ski "assets/kenney/strips/tiny-ski-kit.png"
           :platform "assets/kenney/strips/platform-kit.png"
           :puzzle "assets/kenney/strips/puzzle-kit.png"
           :tower "assets/kenney/strips/tower-defense-kit.png"
           :fish "assets/kenney/strips/fish-kit.png"
           :space "assets/kenney/strips/space-kit.png"
           :pirate "assets/kenney/strips/pirate-kit.png"
           :items "assets/kenney/strips/items-kit.png"
           :particle "assets/kenney/strips/particle-kit.png"
           :food "assets/kenney/strips/food-kit.png"
           :main "/System/Library/Fonts/Supplemental/Arial.ttf"
           :blip "assets/blip.wav"
           :theme "assets/theme.wav"}
  :initial initial
  :update update
  :view view)

(def initial {:t 0 :music false})

(defn hit? [x y w h]
  (and (pointer-released?)
       (point-in-rect? (pointer-x) (pointer-y) (rect-box x y w h))))

(defn open [scene state]
  (do
    (sound/play :blip :volume 0.7)
    (navigation/push scene)
    state))

(defn arm-music [state]
  (if (:music state)
    state
    (do
      (music/play :theme :volume 0.11)
      (assoc state :music true))))

(defn update [dt state]
  (let [base (arm-music state)
        next (assoc base :t (+ (:t base) dt))]
    (cond
      (hit? 16 76 144 28) (open "perfect-shot/game.glyph" next)
      (hit? 168 76 144 28) (open "stack-tower/game.glyph" next)
      (hit? 320 76 144 28) (open "lane-dodger/game.glyph" next)
      (hit? 16 108 144 28) (open "sports-breakaway/game.glyph" next)
      (hit? 168 108 144 28) (open "chip-chase/game.glyph" next)
      (hit? 320 108 144 28) (open "tank-run/game.glyph" next)
      (hit? 16 140 144 28) (open "town-delivery/game.glyph" next)
      (hit? 168 140 144 28) (open "battle-banner/game.glyph" next)
      (hit? 320 140 144 28) (open "ski-slalom/game.glyph" next)
      (hit? 16 172 144 28) (open "platform-hop/game.glyph" next)
      (hit? 168 172 144 28) (open "puzzle-pop/game.glyph" next)
      (hit? 320 172 144 28) (open "tower-trace/game.glyph" next)
      (hit? 16 204 144 28) (open "reef-dash/game.glyph" next)
      (hit? 168 204 144 28) (open "space-run/game.glyph" next)
      (hit? 320 204 144 28) (open "pirate-broadside/game.glyph" next)
      (hit? 16 236 144 28) (open "item-sprint/game.glyph" next)
      (hit? 168 236 144 28) (open "particle-swirl/game.glyph" next)
      (hit? 320 236 144 28) (open "food-rush/game.glyph" next)
      (hit? 16 268 144 28) (open "chef-chaos/game.glyph" next)
      (hit? 168 268 144 28) (open "circuit-keep/game.glyph" next)
      (hit? 320 268 144 28) (open "fishing-cove/game.glyph" next)
      (hit? 16 300 144 28) (open "fussball-fever/game.glyph" next)
      (hit? 168 300 144 28) (open "crown-cavern/game.glyph" next)
      else next)))

(defn icon-frame [i]
  (case (mod i 8)
    0 :f0
    1 :f1
    2 :f2
    3 :f3
    4 :f4
    5 :f5
    6 :f6
    else :f7))

(defn button-color [i]
  (case (mod i 6)
    0 "#203d52"
    1 "#3e3151"
    2 "#2f4938"
    3 "#57402b"
    4 "#29375a"
    else "#4a2d37"))

(defn button [x y label image i]
  (group
    (rect :x x :y y :w 144 :h 28 :color (button-color i))
    (sprite :image image :frame (icon-frame i) :x (+ x 8) :y (+ y 2) :scale 0.44)
    (text :font :main :value label :x (+ x 34) :y (+ y 8) :size 10 :color "#f8fafc")))

(defn view [state]
  (group
    (clear "#111827")
    (rect :x 0 :y 0 :w 480 :h 72 :color "#182235")
    (transform :x 28 :y 14 :rotation (* 5 (sin (* (:t state) 2)))
      (sprite :image :logo :x 0 :y 0 :scale 0.44))
    (text :font :main :value "Glyph Arcade" :x 88 :y 16 :size 28 :color "#f8fafc")
    (text :font :main :value "Kenney-powered microgames" :x 90 :y 48 :size 14 :color "#93c5fd")
    (button 16 76 "Perfect Shot" :orb 0)
    (button 168 76 "Stack Tower" :town 1)
    (button 320 76 "Lane Dodger" :tank 2)
    (button 16 108 "Sports Breakaway" :sports 3)
    (button 168 108 "Chip Chase" :board 4)
    (button 320 108 "Tank Run" :tank 5)
    (button 16 140 "Town Delivery" :town 6)
    (button 168 140 "Battle Banner" :battle 7)
    (button 320 140 "Ski Slalom" :ski 8)
    (button 16 172 "Platform Hop" :platform 9)
    (button 168 172 "Puzzle Pop" :puzzle 10)
    (button 320 172 "Tower Trace" :tower 11)
    (button 16 204 "Reef Dash" :fish 12)
    (button 168 204 "Space Run" :space 13)
    (button 320 204 "Pirate Broadside" :pirate 14)
    (button 16 236 "Item Sprint" :items 15)
    (button 168 236 "Particle Swirl" :particle 16)
    (button 320 236 "Food Rush" :food 17)
    (button 16 268 "Chef Chaos" :food 18)
    (button 168 268 "Circuit Keep" :tower 19)
    (button 320 268 "Fishing Cove" :fish 20)
    (button 16 300 "Fussball Fever" :sports 21)
    (button 168 300 "Crown Cavern" :platform 22)))
