(game arcade-index
  :title "Glyph Arcade"
  :size [480 360]
  :assets {:logo "assets/glyph-logo.png"
           :orb "assets/kenney/strips/puzzle-kit.png"
           :sports "assets/kenney/strips/sports-kit.png"
           :board "assets/kenney/strips/boardgame-kit.png"
           :tank "assets/kenney/strips/tank-kit.png"
           :town "assets/kenney/strips/tiny-town-kit.png"
           :battle "assets/kenney/strips/tiny-battle-kit.png"
           :ski "assets/kenney/strips/tiny-ski-kit.png"
           :platform "assets/kenney/strips/platform-kit.png"
           :puzzle "assets/kenney/strips/puzzle-kit.png"
           :tower "assets/kenney/strips/tower-defense-kit.png"
           :fish "assets/kenney/strips/fish-kit.png"
           :space "assets/kenney/strips/space-kit.png"
           :pirate "assets/kenney/strips/pirate-kit.png"
           :items "assets/kenney/strips/items-kit.png"
           :particle "assets/kenney/strips/particle-kit.png"
           :food "assets/kenney/strips/food-kit.png"
           :main "/System/Library/Fonts/Supplemental/Arial.ttf"
           :blip "assets/blip.wav"
           :theme "assets/theme.wav"}
  :initial initial
  :update update
  :view view)

(def initial {:t 0 :music false})

(defn hit? [x y w h]
  (and (pointer-released?)
       (point-in-rect? (pointer-x) (pointer-y) (rect-box x y w h))))

(defn open [scene state]
  (do
    (sound/play :blip :volume 0.7)
    (navigation/push scene)
    state))

(defn arm-music [state]
  (if (:music state)
    state
    (do
      (music/play :theme :volume 0.11)
      (assoc state :music true))))

(defn update [dt state]
  (let [base (arm-music state)
        next (assoc base :t (+ (:t base) dt))]
    (cond
      (hit? 16 86 144 36) (open "perfect-shot/game.glyph" next)
      (hit? 168 86 144 36) (open "stack-tower/game.glyph" next)
      (hit? 320 86 144 36) (open "lane-dodger/game.glyph" next)
      (hit? 16 128 144 36) (open "sports-breakaway/game.glyph" next)
      (hit? 168 128 144 36) (open "chip-chase/game.glyph" next)
      (hit? 320 128 144 36) (open "tank-run/game.glyph" next)
      (hit? 16 170 144 36) (open "town-delivery/game.glyph" next)
      (hit? 168 170 144 36) (open "battle-banner/game.glyph" next)
      (hit? 320 170 144 36) (open "ski-slalom/game.glyph" next)
      (hit? 16 212 144 36) (open "platform-hop/game.glyph" next)
      (hit? 168 212 144 36) (open "puzzle-pop/game.glyph" next)
      (hit? 320 212 144 36) (open "tower-trace/game.glyph" next)
      (hit? 16 254 144 36) (open "reef-dash/game.glyph" next)
      (hit? 168 254 144 36) (open "space-run/game.glyph" next)
      (hit? 320 254 144 36) (open "pirate-broadside/game.glyph" next)
      (hit? 16 296 144 36) (open "item-sprint/game.glyph" next)
      (hit? 168 296 144 36) (open "particle-swirl/game.glyph" next)
      (hit? 320 296 144 36) (open "food-rush/game.glyph" next)
      else next)))

(defn icon-frame [i]
  (case (mod i 8)
    0 :f0
    1 :f1
    2 :f2
    3 :f3
    4 :f4
    5 :f5
    6 :f6
    else :f7))

(defn button-color [i]
  (case (mod i 6)
    0 "#203d52"
    1 "#3e3151"
    2 "#2f4938"
    3 "#57402b"
    4 "#29375a"
    else "#4a2d37"))

(defn button [x y label image i]
  (group
    (rect :x x :y y :w 144 :h 36 :color (button-color i))
    (sprite :image image :frame (icon-frame i) :x (+ x 8) :y (+ y 5) :scale 0.56)
    (text :font :main :value label :x (+ x 40) :y (+ y 10) :size 11 :color "#f8fafc")))

(defn view [state]
  (group
    (clear "#111827")
    (rect :x 0 :y 0 :w 480 :h 72 :color "#182235")
    (transform :x 28 :y 14 :rotation (* 5 (sin (* (:t state) 2)))
      (sprite :image :logo :x 0 :y 0 :scale 0.44))
    (text :font :main :value "Glyph Arcade" :x 88 :y 16 :size 28 :color "#f8fafc")
    (text :font :main :value "Kenney-powered microgames" :x 90 :y 48 :size 14 :color "#93c5fd")
    (button 16 86 "Perfect Shot" :orb 0)
    (button 168 86 "Stack Tower" :town 1)
    (button 320 86 "Lane Dodger" :tank 2)
    (button 16 128 "Sports Breakaway" :sports 3)
    (button 168 128 "Chip Chase" :board 4)
    (button 320 128 "Tank Run" :tank 5)
    (button 16 170 "Town Delivery" :town 6)
    (button 168 170 "Battle Banner" :battle 7)
    (button 320 170 "Ski Slalom" :ski 8)
    (button 16 212 "Platform Hop" :platform 9)
    (button 168 212 "Puzzle Pop" :puzzle 10)
    (button 320 212 "Tower Trace" :tower 11)
    (button 16 254 "Reef Dash" :fish 12)
    (button 168 254 "Space Run" :space 13)
    (button 320 254 "Pirate Broadside" :pirate 14)
    (button 16 296 "Item Sprint" :items 15)
    (button 168 296 "Particle Swirl" :particle 16)
    (button 320 296 "Food Rush" :food 17)
    (text :font :main :value "Click a game. A/D or arrows in most scenes." :x 130 :y 338 :size 13 :color "#9ca3af")))
