(game arcade-index
  :title "Glyph Arcade"
  :size [480 360]
  :assets {:logo "assets/glyph-logo.png"
           :sports "assets/kenney/strips/sports-kit.png"
           :tank "assets/kenney/strips/tank-kit.png"
           :ski "assets/kenney/strips/tiny-ski-kit.png"
           :platform "assets/kenney/strips/platform-kit.png"
           :tower "assets/kenney/strips/tower-defense-kit.png"
           :fish "assets/kenney/strips/fish-kit.png"
           :space "assets/kenney/strips/space-kit.png"
           :food "assets/kenney/strips/food-kit.png"
           :main "/System/Library/Fonts/Supplemental/Arial.ttf"
           :blip "assets/blip.wav"
           :theme "assets/theme.wav"}
  :initial initial
  :update update
  :view view)

(def initial {:t 0 :music false})

(defn hit? [x y w h]
  (and (pointer-released?)
       (point-in-rect? (pointer-x) (pointer-y) (rect-box x y w h))))

(defn open [scene state]
  (do
    (sound/play :blip :volume 0.7)
    (navigation/push scene)
    state))

(defn arm-music [state]
  (if (:music state)
    state
    (do
      (music/play :theme :volume 0.11)
      (assoc state :music true))))

(defn update [dt state]
  (let [base (arm-music state)
        next (assoc base :t (+ (:t base) dt))]
    (cond
      (hit? 22 96 212 50) (open "ski-slalom/game.glyph" next)
      (hit? 246 96 212 50) (open "asteroid-belt/game.glyph" next)
      (hit? 22 158 212 50) (open "tank-siege/game.glyph" next)
      (hit? 246 158 212 50) (open "circuit-keep/game.glyph" next)
      (hit? 22 220 212 50) (open "crown-cavern/game.glyph" next)
      (hit? 246 220 212 50) (open "fishing-cove/game.glyph" next)
      (hit? 22 282 212 50) (open "chef-chaos/game.glyph" next)
      (hit? 246 282 212 50) (open "fussball-fever/game.glyph" next)
      else next)))

(defn icon-frame [image]
  (case image
    :ski :f3
    :space :f0
    :tank :f0
    :tower :f0
    :platform :f0
    :fish :f0
    :food :f1
    else :f2))

(defn button-color [i]
  (case (mod i 6)
    0 "#203d52"
    1 "#3e3151"
    2 "#2f4938"
    3 "#57402b"
    4 "#29375a"
    else "#4a2d37"))

(defn button [x y label tag image i]
  (group
    (rect :x x :y y :w 212 :h 50 :color (button-color i))
    (rect :x (+ x 6) :y (+ y 6) :w 38 :h 38 :color "#111827")
    (sprite :image image :frame (icon-frame image) :x (+ x 9) :y (+ y 8) :scale 0.58)
    (text :font :main :value label :x (+ x 54) :y (+ y 9) :size 15 :color "#f8fafc")
    (text :font :main :value tag :x (+ x 54) :y (+ y 30) :size 10 :color "#cbd5e1")))

(defn view [state]
  (group
    (clear "#111827")
    (rect :x 0 :y 0 :w 480 :h 72 :color "#182235")
    (transform :x 28 :y 14 :rotation (* 5 (sin (* (:t state) 2)))
      (sprite :image :logo :x 0 :y 0 :scale 0.44))
    (text :font :main :value "Glyph Arcade" :x 88 :y 16 :size 28 :color "#f8fafc")
    (text :font :main :value "8 distinct games with full loops" :x 90 :y 48 :size 14 :color "#93c5fd")
    (button 22 96 "Alpine Rush" "gates, jumps, stamina" :ski 0)
    (button 246 96 "Asteroid Belt" "thrust, shoot, survive" :space 1)
    (button 22 158 "Tank Siege" "arena waves, aim fire" :tank 2)
    (button 246 158 "Circuit Keep" "build towers, hold path" :tower 3)
    (button 22 220 "Crown Cavern" "run, double-jump, collect" :platform 4)
    (button 246 220 "Fishing Cove" "cast, hook, reel tension" :fish 5)
    (button 22 282 "Chef Chaos" "cook orders under pressure" :food 6)
    (button 246 282 "Fussball Fever" "rods, spin shots, goals" :sports 7)))
