(game alpine-rush
  :title "Alpine Rush"
  :size [480 360]
  :assets {:kit {:path "../assets/original/ski.png" :grid {:tile [64 64] :frames {:skier [0 0] :pine [1 0] :hut [2 0] :rock [3 0] :flag [4 0] :snow [5 0]}}}
           :main "../assets/fonts/NotoSans-Regular.ttf" :bold "../assets/fonts/NotoSans-SemiBold.ttf"
           :gate-sound "../assets/audio/gate.wav" :land "../assets/audio/land.wav"
           :impact "../assets/audio/impact.wav" :win "../assets/audio/dock.wav"
           :theme "../assets/audio/alpine-theme.wav"}
  :initial initial :update update :view view)

; Twelve authored sections form the first 60–90 second descent.
; Each pair of gates has a readable approach and an optional outer medal line.
(def sections [[222 295] [310 212] [164 240] [295 350] [285 183] [130 228]
              [274 330] [250 155] [194 285] [345 260] [164 238] [296 240]])
(def finish-y 12200)
(def initial {:phase :brief :music false :t 0 :time 0 :x 240 :y 0 :vx 0 :speed 165 :stamina 100
              :health 3 :score 0 :combo 0 :best-combo 0 :gate 0 :passed 0 :missed 0
              :air 0 :invuln 0 :flash 0 :landed 0 :collected [] :near [] :hits [] :tracks [] :saved false
              :message "Find your line." :message-time 0 :braking false :tucked false})
(defn hit? [x y w h] (and (pointer-released?) (point-in-rect? (pointer-x) (pointer-y) (rect-box x y w h))))
(defn confirm? [] (or (pressed? :confirm) (pressed? :tap)))
(defn gate-y [i] (+ 560 (* i 480)))
(defn gate-x [i] (nth (nth sections (floor (/ i 2))) (mod i 2)))
(defn gate-gap [i] (max 84 (- 146 (* i 2.5))))
(defn obstacle-x [i] (clamp (+ (gate-x i) (if (= (mod i 2) 0) 100 -100)) 80 400))
(defn obstacle-y [i] (+ (gate-y i) 210))
(defn medal-x [i] (clamp (+ (gate-x i) (if (= (mod i 2) 0) 77 -77)) 90 390))
(defn medal-y [i] (+ (gate-y i) 145))
(defn screen-y [s world-y] (+ 250 (* (- world-y (:y s)) -0.34)))
(defn contains-id? [ids i] (not (empty? (filter ids (fn [id] (= id i))))))
(defn medal [s] (cond (and (= (:phase s) :win) (= (:missed s) 0) (empty? (:hits s)) (>= (:score s) 8000)) 3 (= (:phase s) :win) 2 (>= (:passed s) 8) 1 else 0))
(defn record [s]
  (if (:saved s) s
    (do (arcade/complete {:game :alpine :score (:score s) :medals (medal s)
                         :stats {:gates (:passed s) :missed (:missed s) :time (:time s) :combo (:best-combo s)}})
        (assoc s :saved true))))
(defn hurt [s message]
  (if (> (:invuln s) 0) s
    (let [health (- (:health s) 1)]
      (do (sound/play :impact :volume 0.52)
          (assoc s :health health :phase (if (<= health 0) :over :play) :invuln 1.2 :combo 0 :flash 0.7
                   :speed (max 120 (* (:speed s) 0.8)) :message message :message-time 2.4)))))
(defn cross-gate [old s]
  (let [i (:gate s)]
    (if (or (>= i 24) (< (:y s) (gate-y i))) s
      (let [fraction (clamp (/ (- (gate-y i) (:y old)) (max 0.001 (- (:y s) (:y old)))) 0 1)
            crossing-x (lerp (:x old) (:x s) fraction)
            perfect (< (abs (- crossing-x (gate-x i))) 13)
            inside (< (abs (- crossing-x (gate-x i))) (* 0.5 (gate-gap i)))
            next (assoc s :gate (+ i 1))]
        (if inside
          (let [combo (+ (:combo s) 1) points (+ 150 (* 25 (min combo 10)) (if perfect 80 0) (if (:tucked s) 35 0))]
            (do (sound/play :gate-sound :volume 0.48 :pitch (+ 0.9 (* (min combo 10) 0.06)))
                (assoc next :passed (+ (:passed s) 1) :score (+ (:score s) points) :combo combo
                            :best-combo (max combo (:best-combo s)) :flash 0.12
                            :message (str (if perfect "PERFECT LINE" "GATE CLEAR") "  +" points) :message-time 1.2)))
          (hurt (assoc next :combo 0 :missed (+ (:missed s) 1)) "Missed gate. Follow the next gate marker."))))))
(defn encounter [old s i]
  (let [oy (obstacle-y i) dy (abs (- (:y s) oy)) dx (abs (- (:x s) (obstacle-x i)))
        hit (and (< dy 36) (< dx 25) (<= (:air s) 0) (not (contains-id? (:hits s) i)))
        passed (and (< (:y old) (+ oy 36)) (>= (:y s) (+ oy 36)))
        near (and passed (>= dx 25) (< dx 51) (not (contains-id? (:near s) i)))
        collected (and (< (abs (- (:y s) (medal-y i))) 35) (< (abs (- (:x s) (medal-x i))) 24)
                       (not (contains-id? (:collected s) i)))
        next (if hit (hurt (assoc s :hits (push (:hits s) i)) "Hit a rock. Jump or take a wider line.") s)
        next (if near (do (sound/play :land :volume 0.35 :pitch 1.4)
                          (assoc next :near (push (:near next) i) :score (+ (:score next) 90) :message "CLOSE SHAVE +90" :message-time 1.2)) next)]
    (if collected
      (do (sound/play :gate-sound :volume 0.46 :pitch 1.6)
          (assoc next :collected (push (:collected next) i) :score (+ (:score next) 100)
                      :stamina (min 100 (+ (:stamina next) 8)) :message "MEDAL LINE +100" :message-time 1.2)) next)))
(defn check-encounters [old s ids]
  (if (empty? ids) s (check-encounters old (encounter old s (first ids)) (slice ids 1 (count ids)))))
(defn step [dt s]
  (let [steer (axis :move-x) yaxis (axis :move-y)
        tucked (and (> yaxis 0.3) (> (:stamina s) 0)) braking (< yaxis -0.3)
        jump (and (confirm?) (<= (:air s) 0) (>= (:stamina s) 20))
        vx (clamp (+ (* (:vx s) (max 0 (- 1 (* dt (if (= steer 0) 6 2.2))))) (* steer dt (if tucked 480 700))) -220 220)
        speed (clamp (+ (:speed s) (* dt (cond tucked 72 braking -160 else 25))) 115 (if tucked 245 190))
        air (if jump 0.72 (max 0 (- (:air s) dt)))
        landed (and (> (:air s) 0) (<= air 0))
        tracks (if (= (mod (floor (* (:time s) 60)) 4) 0) (push (:tracks s) [(:x s) (:y s)]) (:tracks s))
        next (assoc s :time (+ (:time s) dt) :x (clamp (+ (:x s) (* vx dt)) 48 432) :y (+ (:y s) (* speed dt))
                      :vx vx :speed speed :air air :tucked tucked :braking braking
                      :landed (if landed 0.18 (max 0 (- (:landed s) dt)))
                      :tracks (if (> (count tracks) 35) (slice tracks 1 (count tracks)) tracks)
                      :stamina (clamp (+ (:stamina s) (* dt (if tucked -23 16)) (if jump -20 0)) 0 100)
                      :invuln (max 0 (- (:invuln s) dt))
                      :message-time (max 0 (- (:message-time s) dt)))
        next (cross-gate s next)
        first-i (max 0 (- (:gate next) 2)) last-i (min 24 (+ (:gate next) 1))
        next (check-encounters s next (range first-i last-i))]
    (if jump (sound/play :land :volume 0.35 :pitch 1.4) nil)
    (if landed (sound/play :land :volume 0.3 :pitch 0.85) nil)
    (cond
      (= (:phase next) :over) (record next)
      (>= (:y next) finish-y)
        (do (sound/play :win :volume 0.65)
            (record (assoc next :phase :win :score (+ (:score next) (* (:health next) 200) (max 0 (floor (* (- 90 (:time next)) 12)))))))
      else next)))
(defn start [s] (assoc initial :phase :play :music (:music s)))
(defn update [dt s]
  (let [s (if (:music s) s (do (music/play :theme :volume 0.24) (assoc s :music true)))
        next (assoc s :t (+ (:t s) dt) :flash (max 0 (- (:flash s) (* dt 2))))]
    (cond
      (or (pressed? :cancel) (hit? 12 12 62 32)) (do (navigation/pop) next)
      (= (:phase s) :play) (step dt next)
      (or (confirm?) (hit? 105 275 270 44)) (start next)
      else next)))
(defn label [value x y size color] (text :font :main :value value :x x :y y :size size :color color))
(defn bold [value x y size color] (text :font :bold :value value :x x :y y :size size :color color))
(defn button [value]
  (group (rect :x 105 :y 275 :w 270 :h 38 :color "#f7bd69") (bold value 125 284 14 "#17363c")))
(defn pine [x y scale]
  (group (circle :x (+ x 4) :y (+ y 19) :r (* scale 19) :color "#b2cccd")
         (sprite :image :kit :frame :pine :x x :y y :origin :center :scale scale)))
(defn snow [s]
  (group
    (clear "#e8f1e9")
    (rect :x 0 :y 66 :w 49 :h 258 :color "#aecbc9")
    (rect :x 431 :y 66 :w 49 :h 258 :color "#aecbc9")
    (for [i (range 11)]
      (let [y (+ 60 (mod (+ (* i 57) (* (:y s) 0.34)) 310))]
        (group (pine (+ 14 (mod (* i 19) 28)) y 0.9)
        (pine (+ 439 (mod (* i 11) 27)) (- y 23) 0.85))))
    (for [i (range 22)]
      (line :from [(+ 63 (mod (* i 71) 350)) (+ 76 (mod (+ (* i 39) (* (:y s) 0.34)) 242))]
            :angle 90 :length (+ 4 (mod i 7)) :width 1 :color "#d1e1dc"))))
(defn gate [s i]
  (let [y (screen-y s (gate-y i)) x (gate-x i) gap (* 0.5 (gate-gap i))]
    (if (and (> y 72) (< y 321))
      (group
        (line :from [(- x gap) (+ y 8)] :angle 0 :length (* gap 2) :width 3 :color "#b5d3cf")
        (line :from [(- x gap) (- y 15)] :angle 90 :length 29 :width 3 :color "#247a78")
        (line :from [(+ x gap) (- y 15)] :angle 90 :length 29 :width 3 :color "#247a78")
        (rect :x (- x gap) :y (- y 15) :w 16 :h 12 :color "#e89c52")
        (rect :x (- (+ x gap) 16) :y (- y 15) :w 16 :h 12 :color "#e89c52")
        (circle :x x :y (+ y 8) :r 3 :color "#8fb9af")) empty)))
(defn obstacle [s i]
  (let [y (screen-y s (obstacle-y i)) my (screen-y s (medal-y i))]
    (group
      (if (and (> y 75) (< y 310))
        (group (circle :x (+ (obstacle-x i) 4) :y (+ y 7) :r 16 :color "#b5cfca")
               (sprite :image :kit :frame :rock :x (obstacle-x i) :y y :origin :center :scale 0.55)) empty)
      (if (and (> my 75) (< my 310) (not (contains-id? (:collected s) i)))
        (group (circle :x (medal-x i) :y my :r 8 :color "#d99540")
               (circle :x (medal-x i) :y my :r 5 :color "#ffdb87")) empty))))
(defn skier [s]
  (let [lift (* 16 (sin (* (/ (:air s) 0.72) 3.141592653589793))) x (:x s)]
    (group
      (circle :x (+ x 4) :y 260 :r 12 :color "#adc7c5")
      (for [p (:tracks s)]
        (let [y (screen-y s (nth p 1))]
          (if (< y 322) (group
            (line :from [(- (nth p 0) 5) y] :angle 90 :length 6 :width 2 :color "#c0d8d2")
            (line :from [(+ (nth p 0) 5) y] :angle 90 :length 6 :width 2 :color "#c0d8d2")) empty)))
      (sprite :image :kit :frame :skier :x x :y (- 250 lift) :origin :center
              :scale (if (> (:landed s) 0) 0.62 0.68) :rotation (* (:vx s) 0.045)))))
(defn hud [s]
  (group
    (rect :x 0 :y 0 :w 480 :h 68 :color "#173e46")
    (label "< ARCADE" 16 24 11 "#b6d3cf")
    (bold "ALPINE RUSH" 105 11 22 "#f5f1df")
    (label "01 / PINE RIDGE" 107 43 10 "#b6d3cf")
    (bold (str (:score s)) 352 10 21 "#f7bd69")
    (label (str "LIVES " (:health s) "   x" (:combo s)) 354 42 11 "#c8ded5")
    (rect :x 0 :y 323 :w 480 :h 37 :color "#173e46")
    (label (if (= (:phase s) :play) (str (:passed s) "/24 GATES    " (floor (:time s)) "s") "A 60-90 SECOND DESCENT") 16 334 11 "#c8ded5")
    (label "STAMINA" 312 335 9 "#b6d3cf")
    (rect :x 367 :y 337 :w 95 :h 6 :color "#31565b")
    (rect :x 367 :y 337 :w (* 0.95 (:stamina s)) :h 6 :color "#f7bd69")))
(defn brief []
  (group
    (rect :x 70 :y 83 :w 340 :h 228 :color "#e8f1e9")
    (label "FIND THE FAST LINE." 103 91 11 "#b47e3d")
    (bold "Chase the perfect run." 103 112 25 "#173e46")
    (label "Steer through gates. Chain clean passes." 103 158 13 "#376267")
    (label "Take the outer medals. Jump the rocks." 103 183 13 "#376267")
    (label "Stick / WASD: steer, tuck & brake." 103 213 12 "#376267")
    (label "A / Space: jump. Touch: left pad + right tap." 103 235 11 "#376267")
    (button "START DESCENT  /  A")))
(defn results [s]
  (group
    (rect :x 58 :y 90 :w 364 :h 220 :color "#e8f1e9")
    (bold (if (= (:phase s) :win) "Pine Ridge conquered." "One more descent?") 85 109 25 "#173e46")
    (label (if (= (:phase s) :win) "Your best line is still out there." (:message s)) 85 150 12 "#376267")
    (bold (str (:score s) " POINTS") 85 176 24 "#b47e3d")
    (label (str (:passed s) "/24 gates   /   best chain " (:best-combo s)) 85 216 13 "#376267")
    (label (case (medal s) 3 "GOLD MEDAL / a perfect descent." 2 "SILVER MEDAL / course complete." 1 "BRONZE MEDAL / eight gates cleared." else "Gold: finish clean with 8,000 points.") 85 244 12 "#376267")
    (button "RACE AGAIN  /  A")))
(defn view [s]
  (group
    (snow s)
    (for [i (range 24)] (gate s i))
    (for [i (range 24)] (obstacle s i))
    (if (= (:phase s) :play) (group
      (skier s)
      (if (< (:gate s) 24) (label (str "NEXT " (floor (max 0 (- (gate-y (:gate s)) (:y s))))) (clamp (- (gate-x (:gate s)) 28) 52 358) 79 10 "#3a6d6c") empty)
      (if (> (:message-time s) 0) (label (:message s) 91 299 11 "#173e46") empty)) empty)
    (hud s)
    (case (:phase s) :brief (brief) :play empty else (results s))))
