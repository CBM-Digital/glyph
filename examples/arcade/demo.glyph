; Generated by tools/generate_demo.py from index.glyph.
(game arcade-expedition
  :title "Glyph Arcade / Expedition"
  :size [480 360]
  :assets {:space {:path "assets/original/space.png" :grid {:tile [64 64] :frames {:ship [0 0] :station [1 0]}}}
           :ski {:path "assets/original/ski.png" :grid {:tile [64 64] :frames {:skier [0 0] :pine [1 0]}}}
           :main "assets/fonts/NotoSans-Regular.ttf" :bold "assets/fonts/NotoSans-SemiBold.ttf"
           :blip "assets/audio/gate.wav" :theme "assets/audio/comet-theme.wav"}
  :initial initial :update update :view view)
(def initial {:t 0 :focus 0 :cool 0 :music false})
(def games ["comet-courier/game.glyph" "ski-slalom/game.glyph" "circuit-keep/game.glyph" "chip-flip-blitz/game.glyph" "fishing-cove/game.glyph"])
(def names ["Comet Courier" "Alpine Rush" "Circuit Keep" "Volt Grid" "Fishing Cove"])
(defn hit? [x y w h] (and (pointer-released?) (point-in-rect? (pointer-x) (pointer-y) (rect-box x y w h))))
(defn open [s n]
  (do (sound/play :blip :volume 0.45)
      (profile/set :run-context {:game n :mode :practice :challenge 0 :seed 1907 :content-version 1})
      (navigation/push (nth games n)) s))
(defn update [dt s]
  (let [s (if (:music s) s (do (music/play :theme :volume 0.2) (assoc s :music true)))
        direction (cond (or (pressed? :right) (> (axis :move-x) 0.5)) 1
                        (or (pressed? :left) (< (axis :move-x) -0.5)) -1
                        (or (pressed? :down) (> (axis :move-y) 0.5)) 1
                        (or (pressed? :up) (< (axis :move-y) -0.5)) -1 else 0)
        moved (and (not= direction 0) (<= (:cool s) 0))
        next (assoc s :t (+ (:t s) dt) :focus (if moved (mod (+ (:focus s) direction 2) 2) (:focus s))
                      :cool (if moved 0.23 (max 0 (- (:cool s) dt))))]
    (cond
      (hit? 22 99 212 99) (open next 0)
      (hit? 246 99 212 99) (open next 1)
      (pressed? :confirm) (open next (:focus next))
      (or (hit? 22 323 160 24) (pressed? :secondary))
        (do (profile/set :muted (not (profile/get :muted false))) next)
      else next)))
(defn label [v x y size color] (text :font :main :value v :x x :y y :size size :color color))
(defn bold [v x y size color] (text :font :bold :value v :x x :y y :size size :color color))
(defn selected [s i x y w h]
  (if (= (:focus s) i)
    (group (rect :x (- x 3) :y (- y 3) :w (+ w 6) :h (+ h 6) :color "#f2cc85")
           (rect :x (- x 1) :y (- y 1) :w (+ w 2) :h (+ h 2) :color "#101f2a")) empty))
(defn medals [record x y]
  (for [i (range 3)]
    (circle :x (+ x (* i 12)) :y y :r 3 :color (if (< i (:medals record)) "#f2cc85" "#526a70"))))
(defn view [s]
  (let [comet (profile/get :comet-record {:score 0 :medals 0}) alpine (profile/get :alpine-record {:score 0 :medals 0})]
    (group
      (clear "#101f2a")
      (rect :x 0 :y 0 :w 480 :h 3 :color "#f2cc85")
      (label "G L Y P H" 22 17 12 "#f2cc85")
      (bold "The little arcade expedition" 22 36 24 "#f3efe3")
      (label "Two games. New routes. A better run is waiting." 22 70 12 "#94b1b7")
      (selected s 0 22 99 212 99)
      (rect :x 22 :y 99 :w 212 :h 99 :color "#21384d")
      (for [i (range 12)] (circle :x (+ 31 (mod (* i 37) 180)) :y (+ 106 (mod (* i 23) 75)) :r 1 :color "#647f90"))
      (sprite :image :space :frame :ship :x 187 :y (+ 103 (* 2 (sin (* (:t s) 1.6)))) :scale 0.62 :rotation -25)
      (label "01 / GRAVITY POST" 34 109 9 "#9bb8c8")
      (bold "Comet Courier" 34 130 19 "#f3efe3")
      (label "Six contracts. One little ship." 34 157 11 "#b8cbd4")
      (medals comet 39 184)
      (label (str "BEST " (:score comet)) 119 176 10 "#f2cc85")
      (selected s 1 246 99 212 99)
      (rect :x 246 :y 99 :w 212 :h 99 :color "#285653")
      (sprite :image :ski :frame :pine :x 413 :y 105 :scale 0.6)
      (sprite :image :ski :frame :skier :x 402 :y (+ 108 (* 2 (sin (* (:t s) 2)))) :scale 0.55 :rotation 7)
      (label "02 / PINE RIDGE" 258 109 9 "#b1d4c5")
      (bold "Alpine Rush" 258 130 19 "#f3efe3")
      (label "Find the perfect downhill line." 258 157 11 "#c4dcd2")
      (medals alpine 263 184)
      (label (str "BEST " (:score alpine)) 343 176 10 "#f2cc85")
      (label "A SMALL EXPEDITION. ROOM TO MASTER IT." 22 224 11 "#f2cc85")
      (label "Three deliveries through gravity. One clean mountain descent." 22 248 12 "#94b1b7")
      (label "Earn medals. Save your best. Find another line." 22 272 12 "#94b1b7")
      (label "Stick / arrows to browse     A / Enter to play     Esc to pause" 22 305 10 "#94b1b7")
      (rect :x 22 :y 323 :w 160 :h 23 :color "#223940")
      (label (if (profile/get :muted false) "SOUND OFF / X" "SOUND ON / X") 31 328 10 "#c4dcd2")
      (label "PLAYTEST / SECTOR 01" 341 328 9 "#94b1b7"))))
